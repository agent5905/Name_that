# Browser-safe Supabase configuration. Never place a secret/service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_ACCESS_TOKEN=your_management_access_token
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_ORG_ID=your_organization_id
SUPABASE_DB_PASSWORD=your_database_password

# Cloudflare deployment configuration.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_PAGES_PROJECT_NAME=name-that-team-member

# GitHub automation configuration.
GH_TOKEN=your_github_token
GITHUB_OWNER=your_github_owner
GITHUB_REPO=name-that-team-member
GITHUB_DEFAULT_BRANCH=main

# Application configuration. Host and participant credentials are random opaque
# tokens; no shared signing secret is used.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
